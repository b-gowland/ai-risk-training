# AI Risk Training — environment variables
#
# The app itself needs none: it runs fully client-side with no API keys.
#
# Scene-image generation only (scripts/generate-scenes.mjs) reads this from
# the shell environment, not from a .env file:
#   export GEMINI_API_KEY="..."
#
# VITE_LMS_BUILD=1 is set by scripts/build-scorm.mjs for SCORM packages and
# should not be set by hand.
